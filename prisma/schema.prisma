// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//Prisma is an ORM (object relational mapping) helps to create relational database easier

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//Defining the recipe table
//@default means it autp generates upon creation and uuid is just
//to generate a unique code
//@id means primary key @relation means foreign key

//userId references a Supabase auth.users id. That table lives outside this
//Prisma schema (Supabase Auth owns it), so there's no Prisma-level relation
//or cascade here — just a plain scoping column.
model Recipe {
  id            String    @id   @default(uuid())
  title         String
  description   String?
  photoUrl      String?
  difficulty    String
  totalMinutes  Int
  servings      Int
  cuisine       String?
  //Breakfast | Lunch | Dinner | Snack — the mobile dashboard's filter chips.
  mealtime      String?
  isFavourite   Boolean   @default(false)
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  ingredients   Ingredient[]
  tools         String[]
  steps         Step[]
  createdAt     DateTime  @default(now())
  userId        String

}

model Ingredient {
  id            String    @id   @default(uuid())
  name          String
  quantity      Float
  unit          String
  recipe        Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      String
}

model Step {
  id            String    @id   @default(uuid())
  stepNumber    Int
  instruction   String
  recipe        Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      String
}

