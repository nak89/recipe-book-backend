// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//Prisma is an ORM (object relational mapping) helps to create relational database easier

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//Defining the recipe table
//@default means it autp generates upon creation and uuid is just
//to generate a unique code
//@id means primary key @relation means foreign key

//userId references a Supabase auth.users id. That table lives outside this
//Prisma schema (Supabase Auth owns it), so there's no Prisma-level relation
//or cascade here — just a plain scoping column.
model Recipe {
  id            String    @id   @default(uuid())
  title         String
  description   String?
  photoUrl      String?
  difficulty    String
  totalMinutes  Int
  servings      Int
  cuisine       String?
  //Breakfast | Lunch | Dinner | Snack — the mobile dashboard's filter chips.
  mealtime      String?
  isFavourite   Boolean   @default(false)
  //Nutrition is PER SERVING, not per recipe, and is typed in by the user —
  //nothing derives it from the ingredient list. The columns can't say so
  //themselves, and the whole app depends on the convention. Null means "not
  //known", which is why every one of them is nullable rather than defaulting
  //to 0: a stored 0 would be a claim that this dish has no calories.
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  ingredients   Ingredient[]
  tools         String[]
  steps         Step[]
  mealPlans     MealPlan[]
  createdAt     DateTime  @default(now())
  userId        String

}

//One planned meal: a recipe in one mealtime slot on one day.
//
//`date` is a DATE, not a timestamp, and that is load-bearing. A plan is a
//calendar fact — "Tuesday's dinner" — not an instant, so a timestamp would make
//the row's identity depend on the timezone that wrote it, and the same plan
//would land on a different day for a user who travelled.
//
//The unique constraint is what makes a slot a slot: one recipe per mealtime per
//day, so writing a slot overwrites rather than accumulating. It includes
//`userId` because two accounts can plan the same dinner on the same night.
//
//`recipeId` cascades — unplanning follows deleting, since a slot pointing at a
//recipe that no longer exists has nothing to render. `userId` is a plain
//scoping column with no relation, exactly as on Recipe: that table is Supabase's.
model MealPlan {
  id            String    @id   @default(uuid())
  userId        String
  date          DateTime  @db.Date
  //Breakfast | Lunch | Dinner | Snack — the same stored English values as
  //Recipe.mealtime, translated at the display layer and never in the database.
  mealtime      String
  recipe        Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      String
  createdAt     DateTime  @default(now())

  @@unique([userId, date, mealtime])
  //The planner always reads a week at a time, and always for one user.
  @@index([userId, date])
}

model Ingredient {
  id            String    @id   @default(uuid())
  name          String
  quantity      Float
  unit          String
  recipe        Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      String
}

model Step {
  id            String    @id   @default(uuid())
  stepNumber    Int
  instruction   String
  recipe        Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      String
}

